CREATE TABLE creature_payload (
    content_id TEXT NOT NULL PRIMARY KEY REFERENCES reusable_content(id) ON DELETE CASCADE,
    size TEXT NOT NULL,
    creature_type TEXT NOT NULL,
    alignment TEXT NOT NULL,
    armor_class INTEGER CHECK (armor_class IS NULL OR armor_class > 0),
    armor_class_details TEXT NOT NULL,
    hit_points INTEGER CHECK (hit_points IS NULL OR hit_points > 0),
    hit_dice TEXT NOT NULL,
    speed TEXT NOT NULL,
    strength INTEGER NOT NULL CHECK (strength > 0),
    dexterity INTEGER NOT NULL CHECK (dexterity > 0),
    constitution INTEGER NOT NULL CHECK (constitution > 0),
    intelligence INTEGER NOT NULL CHECK (intelligence > 0),
    wisdom INTEGER NOT NULL CHECK (wisdom > 0),
    charisma INTEGER NOT NULL CHECK (charisma > 0),
    saving_throws TEXT NOT NULL,
    skills TEXT NOT NULL,
    damage_vulnerabilities TEXT NOT NULL,
    damage_resistances TEXT NOT NULL,
    damage_immunities TEXT NOT NULL,
    condition_immunities TEXT NOT NULL,
    senses TEXT NOT NULL,
    languages TEXT NOT NULL,
    challenge_rating TEXT NOT NULL,
    proficiency_bonus INTEGER CHECK (proficiency_bonus IS NULL OR proficiency_bonus >= 0),
    traits TEXT NOT NULL,
    actions TEXT NOT NULL,
    bonus_actions TEXT NOT NULL,
    reactions TEXT NOT NULL,
    legendary_actions TEXT NOT NULL,
    lair_actions TEXT NOT NULL,
    tactics TEXT NOT NULL,
    notes TEXT NOT NULL
);

insertCreaturePayload:
INSERT INTO creature_payload(
    content_id,
    size,
    creature_type,
    alignment,
    armor_class,
    armor_class_details,
    hit_points,
    hit_dice,
    speed,
    strength,
    dexterity,
    constitution,
    intelligence,
    wisdom,
    charisma,
    saving_throws,
    skills,
    damage_vulnerabilities,
    damage_resistances,
    damage_immunities,
    condition_immunities,
    senses,
    languages,
    challenge_rating,
    proficiency_bonus,
    traits,
    actions,
    bonus_actions,
    reactions,
    legendary_actions,
    lair_actions,
    tactics,
    notes
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCreaturePayloadByContentId:
SELECT *
FROM creature_payload
WHERE content_id = ?;

updateCreaturePayload:
UPDATE creature_payload
SET size = ?,
    creature_type = ?,
    alignment = ?,
    armor_class = ?,
    armor_class_details = ?,
    hit_points = ?,
    hit_dice = ?,
    speed = ?,
    strength = ?,
    dexterity = ?,
    constitution = ?,
    intelligence = ?,
    wisdom = ?,
    charisma = ?,
    saving_throws = ?,
    skills = ?,
    damage_vulnerabilities = ?,
    damage_resistances = ?,
    damage_immunities = ?,
    condition_immunities = ?,
    senses = ?,
    languages = ?,
    challenge_rating = ?,
    proficiency_bonus = ?,
    traits = ?,
    actions = ?,
    bonus_actions = ?,
    reactions = ?,
    legendary_actions = ?,
    lair_actions = ?,
    tactics = ?,
    notes = ?
WHERE content_id = ?;
