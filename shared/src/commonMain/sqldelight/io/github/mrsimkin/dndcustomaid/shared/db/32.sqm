CREATE TABLE IF NOT EXISTS dm_dungeon (
    id TEXT NOT NULL PRIMARY KEY,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    ended INTEGER NOT NULL CHECK (ended IN (0, 1)),
    updated_at_epoch_seconds INTEGER NOT NULL CHECK (updated_at_epoch_seconds >= 0),
    document_json TEXT NOT NULL CHECK (length(trim(document_json)) > 0)
);

CREATE INDEX IF NOT EXISTS dm_dungeon_campaign_idx ON dm_dungeon(campaign_id, updated_at_epoch_seconds);

CREATE TABLE IF NOT EXISTS note_payload (
    content_id TEXT NOT NULL PRIMARY KEY REFERENCES reusable_content(id) ON DELETE CASCADE,
    payload_json TEXT NOT NULL CHECK (length(trim(payload_json)) > 0)
);
