CREATE TABLE character_pc_configuration (
    character_id TEXT NOT NULL PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    inspiration_visible INTEGER NOT NULL DEFAULT 1
);

upsertCharacterPcConfiguration:
INSERT OR REPLACE INTO character_pc_configuration(
    character_id, inspiration_visible
)
VALUES (?, ?);

selectCharacterPcConfiguration:
SELECT character_id, inspiration_visible
FROM character_pc_configuration
WHERE character_id = ?;
