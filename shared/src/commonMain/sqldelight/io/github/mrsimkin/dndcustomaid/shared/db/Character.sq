CREATE TABLE character (
    id TEXT NOT NULL PRIMARY KEY,
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    status TEXT NOT NULL,
    updated_at_epoch_seconds INTEGER NOT NULL DEFAULT (CAST(strftime('%s', 'now') AS INTEGER)),
    strength INTEGER NOT NULL DEFAULT 10,
    dexterity INTEGER NOT NULL DEFAULT 10,
    constitution INTEGER NOT NULL DEFAULT 10,
    intelligence INTEGER NOT NULL DEFAULT 10,
    wisdom INTEGER NOT NULL DEFAULT 10,
    charisma INTEGER NOT NULL DEFAULT 10,
    armor_class INTEGER NOT NULL DEFAULT 10,
    max_hp INTEGER NOT NULL DEFAULT 1,
    current_hp INTEGER NOT NULL DEFAULT 1,
    temp_hp INTEGER NOT NULL DEFAULT 0,
    -- Legacy V3 final totals retained only so migration from existing QA databases is safe.
    initiative_modifier INTEGER NOT NULL DEFAULT 0,
    speed INTEGER NOT NULL DEFAULT 30,
    -- Compatibility snapshot only. New authoritative proficiency state is the adjustment below.
    proficiency_bonus INTEGER NOT NULL DEFAULT 2,
    strength_save INTEGER NOT NULL DEFAULT 0,
    dexterity_save INTEGER NOT NULL DEFAULT 0,
    constitution_save INTEGER NOT NULL DEFAULT 0,
    intelligence_save INTEGER NOT NULL DEFAULT 0,
    wisdom_save INTEGER NOT NULL DEFAULT 0,
    charisma_save INTEGER NOT NULL DEFAULT 0,
    passive_perception INTEGER NOT NULL DEFAULT 10,
    spell_save_dc INTEGER,
    initiative_adjustment INTEGER NOT NULL DEFAULT 0,
    passive_perception_adjustment INTEGER NOT NULL DEFAULT 0,
    proficiency_bonus_adjustment INTEGER NOT NULL DEFAULT 0,
    spell_attack_modifier INTEGER,
    spellcasting_ability TEXT NOT NULL DEFAULT 'NONE',
    spellcaster_enabled INTEGER NOT NULL DEFAULT 0,
    general_notes TEXT NOT NULL DEFAULT ''
);

CREATE TABLE character_class (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    level INTEGER NOT NULL,
    hit_die_sides INTEGER NOT NULL,
    hit_dice_remaining INTEGER NOT NULL,
    sort_order INTEGER NOT NULL,
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_save (
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    ability_key TEXT NOT NULL,
    proficient INTEGER NOT NULL DEFAULT 0,
    adjustment INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(character_id, ability_key)
);

CREATE TABLE character_skill (
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    skill_key TEXT NOT NULL,
    -- Legacy V3 final total retained only for safe migration; domain code ignores it.
    modifier INTEGER NOT NULL DEFAULT 0,
    training TEXT NOT NULL,
    adjustment INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(character_id, skill_key)
);

CREATE TABLE character_spell_slot (
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    spell_level INTEGER NOT NULL,
    total_slots INTEGER NOT NULL DEFAULT 0,
    spent_slots INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(character_id, spell_level)
);

CREATE TABLE character_combat_entry (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    attack_modifier INTEGER,
    damage_effect TEXT NOT NULL DEFAULT '',
    range_text TEXT,
    notes TEXT,
    sort_order INTEGER NOT NULL,
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_inventory_item (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    quantity INTEGER NOT NULL DEFAULT 1,
    weight_lb REAL,
    equipped INTEGER NOT NULL DEFAULT 0,
    notes TEXT,
    sort_order INTEGER NOT NULL,
    special INTEGER NOT NULL DEFAULT 0,
    description TEXT,
    location TEXT,
    attuned INTEGER NOT NULL DEFAULT 0,
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_currency (
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    currency_key TEXT NOT NULL,
    name TEXT NOT NULL,
    amount INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(character_id, currency_key),
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_background (
    character_id TEXT NOT NULL PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    background_name TEXT NOT NULL DEFAULT '',
    summary TEXT NOT NULL DEFAULT '',
    race TEXT NOT NULL DEFAULT '',
    religion_faith TEXT NOT NULL DEFAULT '',
    personality_traits TEXT NOT NULL DEFAULT '',
    ideals TEXT NOT NULL DEFAULT '',
    bonds TEXT NOT NULL DEFAULT '',
    flaws TEXT NOT NULL DEFAULT '',
    story TEXT NOT NULL DEFAULT ''
);

CREATE TABLE character_trait (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    source TEXT NOT NULL DEFAULT '',
    trait_type TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    notes TEXT,
    max_uses INTEGER,
    spent_uses INTEGER NOT NULL DEFAULT 0,
    recovery TEXT,
    activation TEXT,
    sort_order INTEGER NOT NULL,
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_note (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    title TEXT NOT NULL,
    content TEXT NOT NULL DEFAULT '',
    sort_order INTEGER NOT NULL,
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_spell_source (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    linked_class_id TEXT,
    sort_order INTEGER NOT NULL,
    UNIQUE(character_id, sort_order)
);

CREATE TABLE character_spell (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    name TEXT NOT NULL,
    spell_level INTEGER NOT NULL,
    casting_time TEXT NOT NULL DEFAULT '',
    range_text TEXT NOT NULL DEFAULT '',
    has_verbal INTEGER NOT NULL DEFAULT 0,
    has_somatic INTEGER NOT NULL DEFAULT 0,
    has_material INTEGER NOT NULL DEFAULT 0,
    material_text TEXT,
    duration TEXT NOT NULL DEFAULT '',
    concentration INTEGER NOT NULL DEFAULT 0,
    ritual INTEGER NOT NULL DEFAULT 0,
    description TEXT NOT NULL DEFAULT '',
    notes TEXT,
    sort_order INTEGER NOT NULL,
    UNIQUE(character_id, spell_level, sort_order)
);

CREATE TABLE character_spell_source_assoc (
    spell_id TEXT NOT NULL REFERENCES character_spell(id) ON DELETE CASCADE,
    source_id TEXT NOT NULL REFERENCES character_spell_source(id) ON DELETE CASCADE,
    prepared INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(spell_id, source_id)
);

insertCharacter:
INSERT INTO character(id, campaign_id, name, status)
VALUES (?, ?, ?, ?);

selectCharactersByCampaign:
SELECT id, campaign_id, name, status, updated_at_epoch_seconds,
       strength, dexterity, constitution, intelligence, wisdom, charisma,
       armor_class, max_hp, current_hp, temp_hp, initiative_adjustment, speed,
       proficiency_bonus, proficiency_bonus_adjustment, passive_perception_adjustment,
       spell_save_dc, spell_attack_modifier, spellcasting_ability,
       spellcaster_enabled, general_notes
FROM character
WHERE campaign_id = ?
ORDER BY name COLLATE NOCASE, id;

selectCharacterById:
SELECT id, campaign_id, name, status, updated_at_epoch_seconds,
       strength, dexterity, constitution, intelligence, wisdom, charisma,
       armor_class, max_hp, current_hp, temp_hp, initiative_adjustment, speed,
       proficiency_bonus, proficiency_bonus_adjustment, passive_perception_adjustment,
       spell_save_dc, spell_attack_modifier, spellcasting_ability,
       spellcaster_enabled, general_notes
FROM character
WHERE id = ?;

updateCharacterCore:
UPDATE character
SET name = ?,
    status = ?,
    updated_at_epoch_seconds = CAST(strftime('%s', 'now') AS INTEGER),
    strength = ?,
    dexterity = ?,
    constitution = ?,
    intelligence = ?,
    wisdom = ?,
    charisma = ?,
    armor_class = ?,
    max_hp = ?,
    current_hp = ?,
    temp_hp = ?,
    initiative_adjustment = ?,
    speed = ?,
    proficiency_bonus = ?,
    proficiency_bonus_adjustment = ?,
    passive_perception_adjustment = ?,
    spell_save_dc = ?,
    spell_attack_modifier = ?,
    spellcasting_ability = ?,
    spellcaster_enabled = ?,
    general_notes = ?
WHERE id = ?;

insertCharacterClass:
INSERT INTO character_class(
    id, character_id, name, level, hit_die_sides, hit_dice_remaining, sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectCharacterClasses:
SELECT id, character_id, name, level, hit_die_sides, hit_dice_remaining, sort_order
FROM character_class
WHERE character_id = ?
ORDER BY sort_order, id;

deleteCharacterClasses:
DELETE FROM character_class
WHERE character_id = ?;

insertCharacterSave:
INSERT OR REPLACE INTO character_save(character_id, ability_key, proficient, adjustment)
VALUES (?, ?, ?, ?);

selectCharacterSaves:
SELECT character_id, ability_key, proficient, adjustment
FROM character_save
WHERE character_id = ?
ORDER BY ability_key;

insertCharacterSkill:
INSERT OR REPLACE INTO character_skill(character_id, skill_key, modifier, training, adjustment)
VALUES (?, ?, 0, ?, ?);

selectCharacterSkills:
SELECT character_id, skill_key, training, adjustment
FROM character_skill
WHERE character_id = ?
ORDER BY skill_key;

insertCharacterSpellSlot:
INSERT OR REPLACE INTO character_spell_slot(character_id, spell_level, total_slots, spent_slots)
VALUES (?, ?, ?, ?);

selectCharacterSpellSlots:
SELECT character_id, spell_level, total_slots, spent_slots
FROM character_spell_slot
WHERE character_id = ?
ORDER BY spell_level;

deleteCharacterSpellSlots:
DELETE FROM character_spell_slot
WHERE character_id = ?;

insertCharacterCombatEntry:
INSERT INTO character_combat_entry(
    id, character_id, name, type, attack_modifier, damage_effect, range_text, notes, sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharacterCombatEntries:
SELECT id, character_id, name, type, attack_modifier, damage_effect, range_text, notes, sort_order
FROM character_combat_entry
WHERE character_id = ?
ORDER BY sort_order, id;

deleteCharacterCombatEntries:
DELETE FROM character_combat_entry
WHERE character_id = ?;

insertCharacterInventoryItem:
INSERT INTO character_inventory_item(
    id, character_id, name, quantity, weight_lb, equipped, notes, sort_order,
    special, description, location, attuned
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharacterInventoryItems:
SELECT id, character_id, name, quantity, weight_lb, equipped, notes, sort_order,
       special, description, location, attuned
FROM character_inventory_item
WHERE character_id = ?
ORDER BY sort_order, id;

deleteCharacterInventoryItems:
DELETE FROM character_inventory_item
WHERE character_id = ?;

insertCharacterCurrency:
INSERT OR REPLACE INTO character_currency(
    character_id, currency_key, name, amount, sort_order, is_default
)
VALUES (?, ?, ?, ?, ?, ?);

selectCharacterCurrencies:
SELECT character_id, currency_key, name, amount, sort_order, is_default
FROM character_currency
WHERE character_id = ?
ORDER BY sort_order, currency_key;

deleteCharacterCurrencies:
DELETE FROM character_currency
WHERE character_id = ?;

upsertCharacterBackground:
INSERT OR REPLACE INTO character_background(
    character_id, background_name, summary, race, religion_faith, personality_traits, ideals, bonds, flaws, story
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharacterBackground:
SELECT character_id, background_name, summary, race, religion_faith, personality_traits, ideals, bonds, flaws, story
FROM character_background
WHERE character_id = ?;

insertCharacterTrait:
INSERT INTO character_trait(
    id, character_id, name, source, trait_type, description, notes,
    max_uses, spent_uses, recovery, activation, sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharacterTraits:
SELECT id, character_id, name, source, trait_type, description, notes,
       max_uses, spent_uses, recovery, activation, sort_order
FROM character_trait
WHERE character_id = ?
ORDER BY sort_order, id;

deleteCharacterTraits:
DELETE FROM character_trait
WHERE character_id = ?;

insertCharacterNote:
INSERT INTO character_note(id, character_id, title, content, sort_order)
VALUES (?, ?, ?, ?, ?);

selectCharacterNotes:
SELECT id, character_id, title, content, sort_order
FROM character_note
WHERE character_id = ?
ORDER BY sort_order, id;

deleteCharacterNotes:
DELETE FROM character_note
WHERE character_id = ?;

insertCharacterSpellSource:
INSERT INTO character_spell_source(id, character_id, name, linked_class_id, sort_order)
VALUES (?, ?, ?, ?, ?);

selectCharacterSpellSources:
SELECT id, character_id, name, linked_class_id, sort_order
FROM character_spell_source
WHERE character_id = ?
ORDER BY sort_order, id;

deleteCharacterSpellSources:
DELETE FROM character_spell_source
WHERE character_id = ?;

insertCharacterSpell:
INSERT INTO character_spell(
    id, character_id, name, spell_level, casting_time, range_text,
    has_verbal, has_somatic, has_material, material_text, duration,
    concentration, ritual, description, notes, sort_order
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharacterSpells:
SELECT id, character_id, name, spell_level, casting_time, range_text,
       has_verbal, has_somatic, has_material, material_text, duration,
       concentration, ritual, description, notes, sort_order
FROM character_spell
WHERE character_id = ?
ORDER BY spell_level, sort_order, id;

deleteCharacterSpells:
DELETE FROM character_spell
WHERE character_id = ?;

insertCharacterSpellSourceAssociation:
INSERT INTO character_spell_source_assoc(spell_id, source_id, prepared)
VALUES (?, ?, ?);

selectCharacterSpellSourceAssociations:
SELECT assoc.spell_id, assoc.source_id, assoc.prepared
FROM character_spell_source_assoc AS assoc
JOIN character_spell AS spell ON spell.id = assoc.spell_id
WHERE spell.character_id = ?
ORDER BY spell.spell_level, spell.sort_order, assoc.source_id;
