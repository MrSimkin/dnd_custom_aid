CREATE TABLE app_account (
    id TEXT NOT NULL PRIMARY KEY,
    external_subject TEXT UNIQUE,
    display_name TEXT
);

CREATE TABLE campaign_membership (
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    account_id TEXT NOT NULL REFERENCES app_account(id) ON DELETE CASCADE,
    role TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    PRIMARY KEY(campaign_id, account_id)
);

CREATE TABLE pc_authority (
    character_id TEXT NOT NULL PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    owner_account_id TEXT REFERENCES app_account(id),
    controller_account_id TEXT REFERENCES app_account(id)
);

CREATE TABLE object_sync_state (
    object_type TEXT NOT NULL,
    object_id TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0),
    deleted_at_epoch_seconds INTEGER,
    PRIMARY KEY(object_type, object_id)
);

upsertAccount:
INSERT INTO app_account(id, external_subject, display_name)
VALUES (?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    external_subject = excluded.external_subject,
    display_name = excluded.display_name;

selectAccountById:
SELECT id, external_subject, display_name
FROM app_account
WHERE id = ?;

upsertCampaignMembership:
INSERT INTO campaign_membership(campaign_id, account_id, role, status)
VALUES (?, ?, ?, ?)
ON CONFLICT(campaign_id, account_id) DO UPDATE SET
    role = excluded.role,
    status = excluded.status;

selectCampaignMembership:
SELECT campaign_id, account_id, role, status
FROM campaign_membership
WHERE campaign_id = ? AND account_id = ?;

selectCampaignMemberships:
SELECT campaign_id, account_id, role, status
FROM campaign_membership
WHERE campaign_id = ?
ORDER BY role, account_id;

selectCharacterCampaignId:
SELECT campaign_id
FROM character
WHERE id = ?;

upsertPcAuthority:
INSERT INTO pc_authority(character_id, owner_account_id, controller_account_id)
VALUES (?, ?, ?)
ON CONFLICT(character_id) DO UPDATE SET
    owner_account_id = excluded.owner_account_id,
    controller_account_id = excluded.controller_account_id;

selectPcAuthority:
SELECT character_id, owner_account_id, controller_account_id
FROM pc_authority
WHERE character_id = ?;

upsertObjectSyncState:
INSERT INTO object_sync_state(object_type, object_id, revision, deleted_at_epoch_seconds)
VALUES (?, ?, ?, ?)
ON CONFLICT(object_type, object_id) DO UPDATE SET
    revision = excluded.revision,
    deleted_at_epoch_seconds = excluded.deleted_at_epoch_seconds;

selectObjectSyncState:
SELECT object_type, object_id, revision, deleted_at_epoch_seconds
FROM object_sync_state
WHERE object_type = ? AND object_id = ?;
