CREATE TABLE dm_content_conflict (
    content_id TEXT NOT NULL PRIMARY KEY,
    reason TEXT NOT NULL,
    hosted_revision INTEGER NOT NULL CHECK (hosted_revision >= 0),
    hosted_snapshot TEXT NOT NULL,
    hosted_deleted INTEGER NOT NULL DEFAULT 0 CHECK (hosted_deleted IN (0, 1)),
    seen_at_epoch_seconds INTEGER NOT NULL CHECK (seen_at_epoch_seconds >= 0)
);

upsertDmContentConflict:
INSERT OR REPLACE INTO dm_content_conflict(content_id, reason, hosted_revision, hosted_snapshot, hosted_deleted, seen_at_epoch_seconds)
VALUES (?, ?, ?, ?, ?, ?);

selectDmContentConflicts:
SELECT content_id, reason, hosted_revision, hosted_snapshot, hosted_deleted, seen_at_epoch_seconds
FROM dm_content_conflict
ORDER BY seen_at_epoch_seconds DESC, content_id;

selectDmContentConflict:
SELECT content_id, reason, hosted_revision, hosted_snapshot, hosted_deleted, seen_at_epoch_seconds
FROM dm_content_conflict
WHERE content_id = ?;

deleteDmContentConflict:
DELETE FROM dm_content_conflict WHERE content_id = ?;
