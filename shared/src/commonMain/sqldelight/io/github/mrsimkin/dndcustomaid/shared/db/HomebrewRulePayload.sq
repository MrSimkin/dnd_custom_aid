CREATE TABLE homebrew_rule_payload (
    content_id TEXT NOT NULL PRIMARY KEY REFERENCES reusable_content(id) ON DELETE CASCADE,
    summary TEXT NOT NULL,
    body TEXT NOT NULL,
    category TEXT NOT NULL,
    rationale TEXT NOT NULL,
    examples_json TEXT NOT NULL,
    related_references_json TEXT NOT NULL,
    tags_json TEXT NOT NULL,
    lifecycle TEXT NOT NULL CHECK (lifecycle IN ('DRAFT', 'ACTIVE', 'RETIRED')),
    notes TEXT NOT NULL
);

insertHomebrewRulePayload:
INSERT INTO homebrew_rule_payload(
    content_id,
    summary,
    body,
    category,
    rationale,
    examples_json,
    related_references_json,
    tags_json,
    lifecycle,
    notes
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHomebrewRulePayloadByContentId:
SELECT *
FROM homebrew_rule_payload
WHERE content_id = ?;

updateHomebrewRulePayload:
UPDATE homebrew_rule_payload
SET summary = ?,
    body = ?,
    category = ?,
    rationale = ?,
    examples_json = ?,
    related_references_json = ?,
    tags_json = ?,
    lifecycle = ?,
    notes = ?
WHERE content_id = ?;
