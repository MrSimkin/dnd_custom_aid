CREATE TABLE IF NOT EXISTS dm_content_sync_baseline (
    content_id TEXT NOT NULL PRIMARY KEY REFERENCES reusable_content(id) ON DELETE CASCADE,
    hosted_revision INTEGER NOT NULL CHECK (hosted_revision >= 0),
    hosted_deleted INTEGER NOT NULL DEFAULT 0 CHECK (hosted_deleted IN (0, 1)),
    snapshot_json TEXT NOT NULL CHECK (length(trim(snapshot_json)) > 0)
);

CREATE TABLE IF NOT EXISTS hosted_dm_content_outbox (
    mutation_id TEXT NOT NULL PRIMARY KEY,
    content_id TEXT NOT NULL REFERENCES reusable_content(id) ON DELETE CASCADE,
    mutation_type TEXT NOT NULL CHECK (mutation_type IN ('CONTENT_PUT', 'CONTENT_DELETE')),
    expected_revision INTEGER NOT NULL CHECK (expected_revision >= 0),
    payload_json TEXT NOT NULL CHECK (length(trim(payload_json)) > 0),
    retry_state TEXT NOT NULL DEFAULT 'READY' CHECK (retry_state IN ('READY', 'BLOCKED')),
    attempt_count INTEGER NOT NULL DEFAULT 0 CHECK (attempt_count >= 0),
    created_at_epoch_seconds INTEGER NOT NULL CHECK (created_at_epoch_seconds >= 0),
    last_attempt_at_epoch_seconds INTEGER CHECK (
        last_attempt_at_epoch_seconds IS NULL OR last_attempt_at_epoch_seconds >= 0
    ),
    last_error_code TEXT,
    last_error_message TEXT
);

CREATE INDEX IF NOT EXISTS hosted_dm_content_outbox_content_idx
ON hosted_dm_content_outbox(content_id, created_at_epoch_seconds, mutation_id);
