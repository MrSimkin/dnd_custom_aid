CREATE TABLE hosted_pc_sync_baseline (
    pc_id TEXT NOT NULL PRIMARY KEY,
    revision INTEGER NOT NULL CHECK (revision >= 0),
    snapshot_json TEXT NOT NULL CHECK (length(trim(snapshot_json)) > 0)
);

upsertBaseline:
INSERT OR REPLACE INTO hosted_pc_sync_baseline(pc_id, revision, snapshot_json)
VALUES (?, ?, ?);

selectBaseline:
SELECT pc_id, revision, snapshot_json
FROM hosted_pc_sync_baseline
WHERE pc_id = ?;

deleteBaseline:
DELETE FROM hosted_pc_sync_baseline
WHERE pc_id = ?;
