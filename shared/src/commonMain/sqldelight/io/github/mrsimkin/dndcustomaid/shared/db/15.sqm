CREATE TABLE app_account (
    id TEXT NOT NULL PRIMARY KEY,
    external_subject TEXT UNIQUE,
    display_name TEXT
);

CREATE TABLE campaign_membership (
    campaign_id TEXT NOT NULL REFERENCES campaign(id) ON DELETE CASCADE,
    account_id TEXT NOT NULL REFERENCES app_account(id) ON DELETE CASCADE,
    role TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'ACTIVE',
    PRIMARY KEY(campaign_id, account_id)
);

CREATE TABLE pc_authority (
    character_id TEXT NOT NULL PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    owner_account_id TEXT REFERENCES app_account(id),
    controller_account_id TEXT REFERENCES app_account(id)
);

CREATE TABLE object_sync_state (
    object_type TEXT NOT NULL,
    object_id TEXT NOT NULL,
    revision INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0),
    deleted_at_epoch_seconds INTEGER,
    PRIMARY KEY(object_type, object_id)
);

INSERT INTO object_sync_state(object_type, object_id, revision, deleted_at_epoch_seconds)
SELECT 'CAMPAIGN', id, 0, NULL FROM campaign;

INSERT INTO object_sync_state(object_type, object_id, revision, deleted_at_epoch_seconds)
SELECT 'PC', id, 0, NULL FROM character;
