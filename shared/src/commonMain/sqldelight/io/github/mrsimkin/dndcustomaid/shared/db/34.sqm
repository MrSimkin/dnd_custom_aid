-- Redesign R4/R5 (owner observation G4): the DM's homebrew rules library, synced as DM content family RULES_ENTRY.
CREATE TABLE IF NOT EXISTS rules_entry_payload (
    content_id TEXT NOT NULL PRIMARY KEY REFERENCES reusable_content(id) ON DELETE CASCADE,
    payload_json TEXT NOT NULL CHECK (length(trim(payload_json)) > 0)
);
